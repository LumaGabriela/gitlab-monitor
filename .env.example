# URL HTTPS da instância GitLab, com ou sem /api/v4.
GITLAB_API_URL=

# Token com escopo read_api e acesso aos projetos. Sem prefixo Bearer.
GITLAB_TOKEN=

# Projeto ou grupo monitorado por padrão. Opcional: o argumento posicional
# passado na execução sobrescreve este valor.
PROJECT=

# Intervalo padrão em minutos. Opcional: --interval sobrescreve este valor.
# Sem PROJECT/INTERVAL aqui e sem argumentos, o intervalo é 15 minutos.
INTERVAL=
